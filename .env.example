# Password for the unlisted /pitch briefing. Share privately with advisors.
PITCH_PASSWORD=discernment

# Google Sheets — deploy scripts/google-sheets-webhook.gs to your spreadsheet (see docs/GOOGLE_SHEETS.md).
GOOGLE_SHEETS_WEBHOOK_URL=
# Must match SHEET_SECRET in the Apps Script file.
GOOGLE_SHEETS_SECRET=change-me-to-a-long-random-string

# Legacy alias for GOOGLE_SHEETS_WEBHOOK_URL (optional).
FORM_WEBHOOK_URL=
